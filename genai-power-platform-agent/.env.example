# Copy this file to .env and fill in a key to enable "live" generation mode.
# Without a key, the assistant runs in mock (extractive) mode automatically —
# no paid API is required to test the RAG pipeline end to end.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for live generation (cheap + fast is enough for this PoC)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
