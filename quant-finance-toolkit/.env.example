# Copy to .env and fill in a key to enable "live" LLM generation mode for the
# research assistant (ai_augmented/research_assistant/). Without a key, it
# runs in mock (extractive) mode automatically — no paid API required.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
