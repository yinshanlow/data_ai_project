# Copy to .env and fill in a key to enable live orchestration (real Claude tool-use routing).
# Without a key, the orchestrator falls back to a rule-based keyword router —
# still fully testable end-to-end at zero cost, just less capable at handling
# ambiguous phrasing (see README's honest failure case).

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where the genai-power-platform-agent FastAPI service is running.
# Start it with: cd ../genai-power-platform-agent && uvicorn rag.api:app --port 8000
POLICY_SERVICE_URL=http://localhost:8000
